{
  "name": "brasil-project-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-comparisons.mjs && node scripts/build-content.js",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/tests/*.test.mjs",
    "check:content": "node scripts/check-content.mjs",
    "build": "node scripts/build-comparisons.mjs && node scripts/build-content.js && npm run typecheck && npm run check:content && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "check:sources": "python3 scripts/check-source-access.py"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "mermaid": "^10.9.1",
    "minisearch": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.5.4",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
